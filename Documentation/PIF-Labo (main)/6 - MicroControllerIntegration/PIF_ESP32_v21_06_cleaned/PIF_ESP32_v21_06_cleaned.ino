  SCALE.power_down();
  SCALE.power_up();
  while (SCALE.is_ready() != 1) {
    //HX711 not found
  }
  //HX711 ready!
  SCALE.set_scale(scale_scale);
  SCALE.set_offset(scale_offset);
  SCALE.tare();
}
